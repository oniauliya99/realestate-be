generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Province {
  id       String     @id
  name     String?
  city     City[]
  district District[]
  village  Village[]
}

model City {
  id         String     @id
  name       String?
  provinceId String
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  district   District[]
  village    Village[]
}

model District {
  id         String    @id
  name       String
  provinceId String
  province   Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  cityId     String
  city       City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  village    Village[]
}

model Village {
  id   String @id
  name String

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  Branch     Branch[]
}

model User {
  id                     Int       @id @default(autoincrement())
  publicId               String    @unique @default(uuid())
  email                  String    @unique
  username               String?
  password               String
  emailVerificationToken String?
  emailVerified          Boolean   @default(false)
  blocked                Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  userRoleId             Int?
  branchId               Int?
  brokerId               Int?
  broker                 Broker?   @relation(fields: [brokerId], references: [id])
  branch                 Branch?   @relation(fields: [branchId], references: [id])
  userRole               UserRole? @relation(fields: [userRoleId], references: [id])
}

model Address {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  address   String
  location  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AddressIdentity {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  address   String
  location  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AddressOffice {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  address   String
  location  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model PersonalInformation {
  id             Int          @id @default(autoincrement())
  publicId       String       @unique @default(uuid())
  identityType   IdentityType @default(KTP)
  identityNumber String
  birthDate      DateTime
  gender         Gender
  placeOfBirth   Json?
  name           String
  phone          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
}

model UserRole {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      Role      @unique @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
}

model Branch {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  code      String    @unique
  name      String
  location  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
  Village   Village?  @relation(fields: [villageId], references: [id])
  villageId String?
}

model Broker {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
}

enum Role {
  SUPERADMIN
  MARKETING
  USER
}

enum IdentityType {
  KTP
  SIM
}

enum Gender {
  PRIA
  WANITA
  LAINNYA
}
