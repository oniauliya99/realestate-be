generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Province {
  id   String  @id
  name String?

  city     City[]
  district District[]
  village  Village[]
}

model City {
  id   String  @id
  name String?

  provinceId String
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  district   District[]
  village    Village[]
}

model District {
  id   String @id
  name String

  provinceId String
  province   Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  cityId     String
  city       City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  village    Village[]
}

model Village {
  id   String @id
  name String

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
}

model User {
  id                     Int       @id @default(autoincrement())
  publicId               String    @unique @default(uuid())
  email                  String    @unique
  username               String?
  password               String
  emailVerificationToken String?
  emailVerified          Boolean   @default(false)
  blocked                Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  userRoleId             String?
  branchId               String?
  brokerId               String?
  broker                 Broker?   @relation(fields: [brokerId], references: [publicId])
  branch                 Branch?   @relation(fields: [branchId], references: [publicId])
  userRole               UserRole? @relation(fields: [userRoleId], references: [publicId])
}

model UserRole {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      Role      @unique @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
}

model Branch {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  code      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
}

model Broker {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  User      User[]
}

enum Role {
  SUPERADMIN
  MARKETING
  USER
}
